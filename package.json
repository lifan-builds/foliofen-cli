{
  "name": "@lifan-builds/foliofen-cli",
  "version": "0.1.1",
  "description": "Foliofen CLI: export your health records locally as Markdown or JSONL.",
  "license": "MIT",
  "bin": {
    "foliofen-cli": "src/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    ".env.example",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md",
    "docs/",
    "scripts/",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifan-builds/foliofen-cli.git"
  },
  "bugs": {
    "url": "https://github.com/lifan-builds/foliofen-cli/issues"
  },
  "homepage": "https://github.com/lifan-builds/foliofen-cli#readme",
  "keywords": [
    "health-records",
    "local-first",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "mychart": "node src/cli.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test": "node --test tests/*.test.mjs",
    "rea": "node scripts/rea.mjs",
    "rea:doctor": "node scripts/rea.mjs doctor --client codex --skill --json",
    "rea:fixture": "node scripts/rea-fixture.mjs",
    "init:live": "node scripts/init-live-harness.mjs",
    "init:live:headless": "node scripts/init-live-headless.mjs",
    "launch:live": "node scripts/launch-live-harness.mjs",
    "check:live": "node scripts/check-live-harness.mjs",
    "validate:live": "node scripts/validate-live-harness.mjs",
    "export:recent": "node scripts/export-recent-records.mjs",
    "foliofen": "node src/cli.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^24.43.0"
  }
}
